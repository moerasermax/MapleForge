<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector"          Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"      Version="17.14.1" />
    <PackageReference Include="xunit"                       Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio"   Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Maple.Core 需明確 ref（transitive ProjectReference 不自動暴露型別） -->
    <ProjectReference Include="..\..\src\Maple.Core\Maple.Core.csproj" />
    <ProjectReference Include="..\..\src\Maple.Adapters.V113\Maple.Adapters.V113.csproj" />
    <ProjectReference Include="..\..\src\Maple.Versioning\Maple.Versioning.csproj" />
    <!-- HeadlessClient Exe 可被 test project reference；xunit 不會執行其 Main -->
    <ProjectReference Include="..\..\tools\Maple.Tools.HeadlessClient\Maple.Tools.HeadlessClient.csproj" />
  </ItemGroup>

</Project>
