<Project Sdk="Microsoft.NET.Sdk">

  <!-- headless 協定客戶端：不需 GUI，直接走 TCP + cipher 學 v113 s2c 協定。
       北極星：協定知識在 Adapters.V113；此工具只「使用」cipher，不進 Maple.Core 的 domain。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Maple.Tools.HeadlessClient</AssemblyName>
    <RootNamespace>Maple.Tools.HeadlessClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maple.Core\Maple.Core.csproj" />
    <ProjectReference Include="..\..\src\Maple.Adapters.V113\Maple.Adapters.V113.csproj" />
    <ProjectReference Include="..\..\src\Maple.Versioning\Maple.Versioning.csproj" />
    <ProjectReference Include="..\Maple.Tools.PacketDecoder\Maple.Tools.PacketDecoder.csproj" />
  </ItemGroup>

</Project>
